{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JKCodingAgent",
  "version": "0.2.1",
  "identifier": "com.jk.jkcodingagent",
  "build": {
    "beforeDevCommand": "pnpm pi-sidecar:build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm pi-sidecar:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JKCodingAgent",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 680,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$HOME/.jkcodingagent/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/browser-sidecar/*"
    ],
    "externalBin": [
      "binaries/rag-server",
      "binaries/pi-agent-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
