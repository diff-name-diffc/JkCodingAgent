{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JKCodingAgent",
  "version": "0.2.1",
  "identifier": "com.jk.jkcodingagent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JKCodingAgent",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 680,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost chat-image: http://chat-image.localhost data: blob:; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$HOME/.jkcodingagent/chat-images/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "resources/browser-sidecar/driver.py": "browser-sidecar/driver.py",
      "resources/browser-sidecar/bootstrap.py": "browser-sidecar/bootstrap.py",
      "resources/browser-sidecar/diagnostics.py": "browser-sidecar/diagnostics.py",
      "resources/browser-sidecar/runtime.py": "browser-sidecar/runtime.py",
      "resources/browser-sidecar/explorer.py": "browser-sidecar/explorer.py",
      "resources/browser-sidecar/model.py": "browser-sidecar/model.py",
      "resources/browser-sidecar/dialogs.py": "browser-sidecar/dialogs.py",
      "resources/browser-sidecar/navigation.py": "browser-sidecar/navigation.py",
      "resources/browser-sidecar/previews.py": "browser-sidecar/previews.py"
    },
    "externalBin": [
      "binaries/rag-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
