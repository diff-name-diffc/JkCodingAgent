{
  "name": "jkcodingagent",
  "private": true,
  "version": "0.2.1",
  "description": "An Agent-First Application For Vibe Coding",
  "author": "",
  "homepage": "https://github.com/diff-name-diffc/JkCodingAgent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diff-name-diffc/JkCodingAgent.git"
  },
  "bugs": {
    "url": "https://github.com/diff-name-diffc/JkCodingAgent/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "rag:dev": "cd rag && uv run python -m rag_server",
    "rag:sync": "cd rag && uv sync",
    "rag:build": "bash rag/scripts/build_sidecar.sh",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/themes": "^3.3.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "cloakbrowser": "^0.3.31",
    "katex": "^0.16.45",
    "lucide-react": "^1.7.0",
    "monaco-editor": "^0.55.1",
    "playwright-core": "^1.59.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
