  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "rag:dev": "cd rag && uv run python -m rag_server",
    "rag:sync": "cd rag && uv sync",
    "rag:build": "bash rag/scripts/build_sidecar.sh",
    "test": "vitest run",
    "contract:check": "node scripts/check-tauri-command-contract.mjs",
    "styles:report": "node scripts/report-ai-class-references.mjs",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "predev": "node scripts/sync-excalidraw-assets.mjs",
    "prebuild": "node scripts/sync-excalidraw-assets.mjs"
  },
