{
  "name": "jkcodingagent",
  "private": true,
  "version": "0.2.1",
  "description": "An Agent-First Application For Vibe Coding",
  "author": "",
  "homepage": "https://github.com/diff-name-diffc/JkCodingAgent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diff-name-diffc/JkCodingAgent.git"
  },
  "bugs": {
    "url": "https://github.com/diff-name-diffc/JkCodingAgent/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "rag:dev": "cd rag && uv run python -m rag_server",
    "rag:sync": "cd rag && uv sync",
    "rag:build": "bash rag/scripts/build_sidecar.sh",
    "pi-sidecar:build": "pnpm --dir sidecars/pi-agent build",
    "pi-sidecar:check": "pnpm --dir sidecars/pi-agent check",
    "test": "vitest run && pnpm --dir sidecars/pi-agent test",
    "contract:check": "node scripts/check-tauri-command-contract.mjs",
    "styles:report": "node scripts/report-ai-class-references.mjs",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.1",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.67.0",
    "@tanstack/react-virtual": "3.13.12",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "cloakbrowser": "^0.4.4",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^11.18.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.21.0",
    "monaco-editor": "^0.55.1",
    "playwright-core": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "4.1.0"
  }
}
